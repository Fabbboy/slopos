# Vendored TCB annexes are pinned by content tree hash (scripts/check_vendor_pin.sh),
# so every file in them — including Cargo.lock — must be tracked.
!vendor/**/Cargo.lock
**/*.rs.bk

# Runtime filesystem images (generated by build/test)
fs/assets/ext2.img
fs/assets/ext2-tests.img

# Editor/IDE config
